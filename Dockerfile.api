# The API service. Note it does NOT contain the sandbox -- it drives Docker on
# the host to create one container per run, so it needs the docker CLI and a
# mounted docker socket:
#
#   docker build -f Dockerfile.api -t repo-triage-api .
#   docker run --rm -p 8080:8080 \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -e ANTHROPIC_API_KEY -e ANTHROPIC_WORKSPACE_ID -e TRIAGE_API_KEY \
#     repo-triage-api
#
# Mounting the socket gives this container control of the host's Docker daemon.
# That is why the endpoint is authenticated and rate limited, and why it should
# not be exposed to an untrusted network.

FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends docker.io ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# Streamlit and pandas belong to the dashboard, not the service.
RUN grep -viE '^(streamlit|pandas)' requirements.txt > /tmp/req.txt \
 && pip install --no-cache-dir -r /tmp/req.txt

COPY src/ ./src/
COPY data/ ./data/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8080/health')"

CMD ["uvicorn", "api:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8080"]
