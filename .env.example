# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-...

# Required when the key is identity-linked: the API rejects such keys with a
# 400 unless every request carries a workspace id.
ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional. Raises the GitHub API rate limit from 60/hr to 5000/hr when
# fetching issues. Read-only scope is sufficient.
GITHUB_TOKEN=

# Langfuse tracing. These match the LANGFUSE_INIT_* values baked into
# docker-compose.langfuse.yml, so `docker compose -f docker-compose.langfuse.yml
# up -d` plus this file is all it takes to get traces locally.
# Tracing is optional: unset the keys or set LANGFUSE_ENABLED=0 and the agent
# runs identically with tracing disabled.
LANGFUSE_PUBLIC_KEY=pk-lf-repo-triage-local
LANGFUSE_SECRET_KEY=sk-lf-repo-triage-local
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_ENABLED=1
